{
  "model": "sonnet",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "PowerShell(python tools/*)",
      "Bash(python tools/*)",
      "PowerShell(python bench/*)",
      "Bash(python bench/*)"
    ],
    "deny": [
      "Read(./data/**)",
      "Edit(./data/**)",
      "Edit(./rules/**)",
      "Bash(rm *data*)",
      "PowerShell(Remove-Item *data*)",
      "Bash(rm *rules*)",
      "PowerShell(Remove-Item *rules*)"
    ]
  }
}
